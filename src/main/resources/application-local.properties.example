# ===================================================================
# Local Development Overrides Template
# Copy this file to 'application-local.properties' and set your local credentials.
# 'application-local.properties' is ignored by Git to keep passwords safe.
# ===================================================================

server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/lost_and_found_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
spring.datasource.username=YOUR_LOCAL_MYSQL_USER
spring.datasource.password=YOUR_LOCAL_MYSQL_PASSWORD

spring.thymeleaf.cache=false
spring.jpa.hibernate.ddl-auto=update

app.upload.dir=uploads
app.seed-data=true
